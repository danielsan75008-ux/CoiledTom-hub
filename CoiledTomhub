--// 💥 EXECUTOR DE SCRIPTS (corrigido)
local function executeScript(link)
    print("[CoiledTomHub] Executando:", link)

    local s, err = pcall(function()
        loadstring(game:HttpGet(link))()
    end)

    if not s then
        warn("⚠️ Erro ao carregar script:", err)
    end
end

--// Função para criar abas
local ActiveTab = nil
local CreatedTabs = {}

local function CreateTab(tabName, buttons)
    local TabButton = Instance.new("TextButton", TabHolder)
    TabButton.BackgroundColor3 = Color3.fromRGB(40, 0, 70)
    TabButton.Text = tabName
    TabButton.Font = Enum.Font.GothamBold
    TabButton.TextColor3 = Color3.fromRGB(255, 255, 255)
    TabButton.TextSize = 14
    TabButton.Size = UDim2.new(0, 140, 0, 35)

    local TabCorner = Instance.new("UICorner", TabButton)
    TabCorner.CornerRadius = UDim.new(0, 8)

    local ScrollContent = Instance.new("ScrollingFrame", ContentFrame)
    ScrollContent.Size = UDim2.new(1, 0, 1, 0)
    ScrollContent.Visible = false
    ScrollContent.BackgroundTransparency = 1
    ScrollContent.ScrollBarThickness = 6
    ScrollContent.AutomaticCanvasSize = Enum.AutomaticSize.Y
    ScrollContent.ScrollBarImageColor3 = Color3.fromRGB(180, 100, 255)

    local UIListLayout = Instance.new("UIListLayout", ScrollContent)
    UIListLayout.Padding = UDim.new(0, 10)
    UIListLayout.SortOrder = Enum.SortOrder.LayoutOrder

    for _, info in ipairs(buttons) do
        local Btn = Instance.new("TextButton", ScrollContent)
        Btn.Size = UDim2.new(1, 0, 0, 40)
        Btn.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
        Btn.Text = info.name
        Btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        Btn.Font = Enum.Font.Gotham
        Btn.TextSize = 16

        local BtnCorner = Instance.new("UICorner", Btn)
        BtnCorner.CornerRadius = UDim.new(0, 8)

        Btn.MouseEnter:Connect(function()
            Btn.BackgroundColor3 = Color3.fromRGB(80, 0, 150)
        end)
        Btn.MouseLeave:Connect(function()
            Btn.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
        end)

        Btn.MouseButton1Click:Connect(function()
            executeScript(info.link)
        end)
    end

    TabButton.MouseButton1Click:Connect(function()
        if ActiveTab then
            ActiveTab.Visible = false
        end
        ScrollContent.Visible = true
        ActiveTab = ScrollContent
    end)

    table.insert(CreatedTabs, ScrollContent)
end

